{
  "name": "devis-renovation",
  "productName": "Devis Rénovation",
  "version": "1.0.2",
  "description": "Калькулятор стоимости ремонта и подготовка коммерческого предложения (Devis)",
  "main": "main.js",
  "author": "Kadychev Alexandre",
  "license": "MIT",
  "scripts": {
    "seed": "node tools/extract-seed.js",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5",
    "archiver-utils": "2.1.0",
    "brace-expansion": "5.0.12",
    "balanced-match": "4.0.4",
    "@fast-csv/format": "4.3.5",
    "@fast-csv/parse": "4.3.6",
    "es-abstract-get": "1.0.0",
    "call-bind-apply-helpers": "1.0.2",
    "side-channel-list": "1.0.1",
    "side-channel-map": "1.0.1",
    "side-channel-weakmap": "1.0.2"
  },
  "build": {
    "appId": "com.kadychev.devisrenovation",
    "productName": "Devis Rénovation",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "node_modules/call-bind-apply-helpers/**/*"
    ],
    "directories": {
      "output": "release-102"
    },
    "afterPack": "tools/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Devis Rénovation",
      "artifactName": "Setup-Devis-Renovation-${version}.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  }
}
